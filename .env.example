# ChatCFD 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# -- LLM 配置 --
# 通义千问 (DashScope)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
MODEL_ID=openai/qwen-plus
OPENAI_API_KEY=sk-your-api-key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# -- 服务端口 --
# PostService 默认 8001（避免与 SimGraph 的 8000 冲突）
POST_SERVICE_PORT=8001
MCP_URL=http://127.0.0.1:8001/mcp/sse
AGENT_PORT=8090
# 前端可选 Vite 环境变量（在 web/.env.local 设置）：
# VITE_POST_SERVICE_URL=http://localhost:8001
# VITE_AGENT_WS_URL=ws://localhost:8090/ws

# -- 可选功能 --
MEMPALACE_ENABLED=false
